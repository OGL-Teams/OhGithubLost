<svg viewBox="0 0 512 512" role="img" aria-label="OGL 图标" xmlns="http://www.w3.org/2000/svg">
  <!--
    OGL 应用图标（**背景透明**）。
    这是几何形状的**唯一事实来源**：
    - Android：转成 VectorDrawable（矢量 XML）+ 自适应图标；
    - Windows：256 单帧 ICO；Linux：2048 PNG 母版。
    转换由 tool/inject_platform_spec.py 依据 tool/platform_spec.yaml 在构建期完成。
  -->
  <defs>
    <linearGradient id="bodyGrad" x1="0" y1="0" x2="1" y2="1">
      <stop offset="0" stop-color="#2F3441"/>
      <stop offset=".5" stop-color="#171A21"/>
      <stop offset="1" stop-color="#08090C"/>
    </linearGradient>
    <linearGradient id="eyeGrad" x1="0" y1="0" x2="0" y2="1">
      <stop offset="0" stop-color="#FFE7A3"/>
      <stop offset=".5" stop-color="#FFC93C"/>
      <stop offset="1" stop-color="#D98E05"/>
    </linearGradient>
  </defs>

  <polygon fill="url(#bodyGrad)" points="128,96 256,192 384,96 416,320 256,448 96,320"/>

  <g fill="url(#eyeGrad)">
    <polygon points="160,256 224,256 192,320"/>
    <polygon points="288,256 352,256 320,320"/>
  </g>
</svg>

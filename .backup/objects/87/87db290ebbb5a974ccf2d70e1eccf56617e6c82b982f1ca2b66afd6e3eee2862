# Netlify 站点配置 · OhGithubLost 更新日志
#
# 作用：把仓库里的 `changed/`（Jekyll 更新日志站点）发布到 Netlify，
#      作为 GitHub Pages 之外的镜像 / 加速入口，内容与 Pages 完全一致。
#
# 接入步骤（在 Netlify 后台）：
#   1. Add new site → Import an existing project → 选 yingo-server/OhGithubLost
#   2. Build command 与 Publish directory 保持本文件中的设置（或直接让
#      Netlify 读取本文件）
#   3. 部署完成后，把 *.netlify.app 域名回填到 changed/_config.yml 的 url 字段
#
# 注意：构建期间不会执行任何仓库脚本，只有 Jekyll 静态编译。

[build]
  # `changed/` 是仓库根下的子目录，Netlify 默认把仓库根当站点根，
  # 故把 base 指向该子目录 —— Jekyll 随后就在 `changed/` 里读到
  # `_config.yml` 与 `_posts/`，与 GitHub Pages 用的是同一份源。
  base = "changed"
  # ★ publish 是「相对 base」的路径（Netlify 官方约定），base 已是 changed/，
  #   故这里只写 _site；写成 changed/_site 会被拼成 changed/changed/_site。
  publish = "_site"
  # ★ 必须走 bundle exec：否则 Netlify 会用镜像自带的 Jekyll（版本随镜像漂移），
  #   而 changed/Gemfile 已把 jekyll / minima / Ruby 锁到与 GitHub Pages
  #   `github-pages 232` 完全一致的版本，两个渠道的产物才能保持一致。
  #   （Gemfile 与 base 同目录，bundler 会自动定位，无需 BUNDLE_GEMFILE）
  command = "bundle exec jekyll build"

[build.environment]
  JEKYLL_ENV = "production"
  # 与 changed/Gemfile 中的 ruby "3.2.4" 对应；Netlify 依此挑选构建镜像。
  RUBY_VERSION = "3.2.4"
  # 站点无第三方插件，公开构建不需要任何 token；同时避免误装付费插件。
  NETLIFY_USE_YARN = false

# ── 缓存 ────────────────────────────────────────────────────────────────
# 页面随每次发布变化，因此 HTML 一律不缓存（must-revalidate 交给浏览器校验），
# 保证订阅者总能第一时间看到新版本说明。
[[headers]]
  for = "/*.html"
  [headers.values]
    Cache-Control = "public, max-age=0, must-revalidate"

# 静态资源内容带内容指纹，可长期缓存 + immutable，重复访问直接命中边缘。
[[headers]]
  for = "/assets/*"
  [headers.values]
    Cache-Control = "public, max-age=31536000, immutable"

# ── 安全响应头 ──────────────────────────────────────────────────────────
[[headers]]
  for = "/*"
  [headers.values]
    X-Content-Type-Options = "nosniff"
    Referrer-Policy = "strict-origin-when-cross-origin"
    X-Frame-Options = "SAMEORIGIN"
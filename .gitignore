# Flutter / Dart
.dart_tool/
.packages
build/
pubspec.lock

# IDE
.idea/
*.iml
.vscode/

# OS
.DS_Store
Thumbs.db

# 平台工程目录（由 CI 的 `flutter create` 现场生成，永不入库）
android/
ios/
linux/
macos/
windows/
# `web/` 是 PWA 脚手架（index.html / manifest.json / 图标）—— **属于源码，需入库**；
# `app/` 是 Web 的按版本发布目录（app/v650/ + 入口 iframe）—— 由 web 分支上的
# `web.yml` 构建并提交，同样需要入库（入口地址要长期可访问）。
# 二者此前被当作构建产物忽略，改用 app/ 方案后必须放行。
!android/.gitkeep

# Android 构建缓存
android/.gradle/
android/local.properties
android/key.properties
*.jks
*.keystore

# 构建产物
*.apk
*.aab
*.zip
*.tar.gz

# 构建时生成的引导清单注入件（CI 产物，勿入库）
dart_define.json
boot_manifest.json

# 密钥与私密文件（禁止入库；CI 用 Actions Secrets 还原）
.github/signing/ogl-boot-ed25519.key
.github/signing/ogl-debug.keystore.b64

# 会话临时 / 备份
.backup/
__pycache__/
*.pyc

# HyperFrames 本地运行痕迹
.hyperframes/

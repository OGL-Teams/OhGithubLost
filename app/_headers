/js/1010/index.html
  Cache-Control: public, max-age=0, must-revalidate
/wasm/1010/index.html
  Cache-Control: public, max-age=0, must-revalidate
# 入口与版本清单：始终回源校验（新版本要立刻可见）
/
  Cache-Control: public, max-age=0, must-revalidate
/index.html
  Cache-Control: public, max-age=0, must-revalidate
/versions.json
  Cache-Control: public, max-age=0, must-revalidate

# 版本化产物桶：目录名含版本号 → 内容不可变 → 强缓存一年
/wasm/*
  Cache-Control: public, max-age=31536000, immutable
/js/*
  Cache-Control: public, max-age=31536000, immutable

# 历史纯数字目录（7xx / v7xx）
/7*
  Cache-Control: public, max-age=31536000, immutable
/v7*
  Cache-Control: public, max-age=31536000, immutable

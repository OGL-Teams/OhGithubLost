# Flutter Web 静态资源永久缓存（带 hash 文件名）
/*
  Cache-Control: public, max-age=0, must-revalidate
/assets/*
  Cache-Control: public, max-age=31536000, immutable
/canvaskit/*
  Cache-Control: public, max-age=31536000, immutable
/flutter_service_worker.js
  Cache-Control: public, max-age=0, must-revalidate
/main.dart.js
  Cache-Control: public, max-age=31536000, immutable
/main.dart.wasm
  Cache-Control: public, max-age=31536000, immutable
/flutter_bootstrap.js
  Cache-Control: public, max-age=31536000, immutable
*.wasm
  Cache-Control: public, max-age=31536000, immutable
*.js
  Cache-Control: public, max-age=31536000, immutable
*.png
  Cache-Control: public, max-age=31536000, immutable